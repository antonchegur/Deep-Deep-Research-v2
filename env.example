# API Keys
OPENAI_API_KEY=your_openai_api_key_here
DUCKDUCKGO_API_KEY=your_duckduckgo_api_key_here
ARXIV_API_KEY=your_arxiv_api_key_here  # if required

# Configuration
RESEARCH_MODE=standard  # quick, standard, deep
MAX_SOURCES=50
DEBUG_MODE=false
LOG_LEVEL=info  # debug, info, warning, error

# Services
API_HOST=0.0.0.0
API_PORT=8000
TIMEOUT_SECONDS=120

# PDF Generation
PDF_TEMPLATE=modern-1  # modern-1, academic, business

# Languages
DEFAULT_LANGUAGE=en  # en, ru, es, kk 